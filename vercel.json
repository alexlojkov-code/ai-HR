{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "outputDirectory": "public",
  "cleanUrls": false,
  "functions": {
    "api/*.js": { "maxDuration": 25 },
    "api/review.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/delo", "destination": "/index.html" },
    { "source": "/interview/:p", "destination": "/index.html" },
    { "source": "/reviewing", "destination": "/index.html" },
    { "source": "/dossier/:p", "destination": "/index.html" },
    { "source": "/archive", "destination": "/index.html" },
    { "source": "/archive/:p", "destination": "/index.html" },
    { "source": "/uz", "destination": "/index.html" },
    { "source": "/uz/delo", "destination": "/index.html" },
    { "source": "/uz/interview/:p", "destination": "/index.html" },
    { "source": "/uz/reviewing", "destination": "/index.html" },
    { "source": "/uz/dossier/:p", "destination": "/index.html" },
    { "source": "/uz/archive", "destination": "/index.html" },
    { "source": "/uz/archive/:p", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
        { "key": "Permissions-Policy", "value": "camera=(), microphone=(self), geolocation=()" },
        { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data:; connect-src 'self'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/fonts/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/api/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store" }]
    }
  ]
}
