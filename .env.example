# Ключ Gemini API. В Vercel — Sensitive, Production + Preview.
GEMINI_API_KEY=
# Цепочка моделей через запятую: первая основная, дальше запасные.
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Необязательно: отдельная цепочка для узбекского.
GEMINI_MODELS_UZ=
# 1 — отвечать заготовками без вызова модели (локально и для тестов).
AI_MOCK=1
# Аварийный выключатель мата: 0 — мат запрещён всем, независимо от галочки.
PROFANITY_ENABLED=1
